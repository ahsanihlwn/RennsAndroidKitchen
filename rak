#!/usr/bin/env sh
# SPDX-License-Identifier: MPL-2.0
# Cross-platform POSIX (macOS & Linux) launcher for the Renns Android Kitchen CLI.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$DIR/run" ]; then
    exec "$DIR/run" --rak-cli "$@"
fi
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
PYTHON_BIN="${RAK_PYTHON:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi
exec "$PYTHON_BIN" "$DIR/core/rak_cli.py" "$@"
