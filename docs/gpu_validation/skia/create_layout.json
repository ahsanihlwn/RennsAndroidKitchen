    "text": null,
    "stylesheet": "\nQWidget {\n    background-color: #1e2430;\n    color: #d8dee9;\n    font-family: 'Poppins', 'Inter', 'Segoe UI', sans-serif;\n    font-size: 13px;\n}\nQLineEdit {\n    background-color: #212a38;\n    border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 7px;\n    padding: 6px 10px;\n    color: #d8dee9;\n}\nQLineEdit:focus {\n    border: 1px solid rgba(136,192,208,0.55);\n    background-color: #2e3f55;\n}\nQLineEdit:disabled {\n    color: #28303e;\n    background-color: #18202c;\n    border-color: rgba(255,255,255,0.04);\n}\nQRadioButton {\n    spacing: 8px;\n    color: #d8dee9;\n}\nQRadioButton::indicator {\n    width: 14px; height: 14px;\n    border-radius: 7px;\n    border: 1px solid rgba(255,255,255,0.2);\n    background: transparent;\n}\nQRadioButton::indicator:checked {\n    background-color: rgba(136,192,208,0.85);\n    border: 1px solid rgba(136,192,208,0.7);\n}\nQPushButton {\n    background: rgba(255,255,255,0.05);\n    border: 1px solid rgba(255,255,255,0.09);\n    border-radius: 7px;\n    padding: 0 14px;\n    height: 30px;\n    color: #88c0d0;\n    font-size: 12px;\n}\nQPushButton:hover {\n    background: rgba(255,255,255,0.09);\n    border-color: rgba(255,255,255,0.15);\n    color: #eceff4;\n}\nQPushButton:pressed { background: rgba(255,255,255,0.13); }\nQPushButton:disabled {\n    color: #202830;\n    background: rgba(255,255,255,0.02);\n    border-color: rgba(255,255,255,0.04);\n}\nQPushButton[role=\"primary\"] {\n    background: rgba(136,192,208,0.18);\n    border: 1px solid rgba(136,192,208,0.38);\n    color: #88c0d0;\n    font-weight: 600;\n}\nQPushButton[role=\"primary\"]:hover {\n    background: rgba(136,192,208,0.3);\n    border-color: rgba(136,192,208,0.55);\n    color: #a8d8e8;\n}\nQPushButton[role=\"primary\"]:pressed { background: rgba(136,192,208,0.44); }\nQPushButton[role=\"primary\"]:disabled {\n    background: rgba(136,192,208,0.07);\n    border-color: rgba(136,192,208,0.12);\n    color: rgba(136,192,208,0.3);\n}\nQScrollBar:vertical {\n    background: transparent; width: 4px; margin: 0; border: none;\n}\nQScrollBar::handle:vertical {\n    background: #354560; border-radius: 2px; min-height: 20px;\n}\nQScrollBar::handle:vertical:hover { background: rgba(136,192,208,0.45); }\nQScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,\nQScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {\n    height: 0; border: none; background: transparent;\n}\nQScrollBar:horizontal {\n    background: transparent; height: 4px; margin: 0; border: none;\n}\nQScrollBar::handle:horizontal {\n    background: #354560; border-radius: 2px; min-width: 20px;\n}\nQScrollBar::handle:horizontal:hover { background: rgba(136,192,208,0.45); }\nQScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,\nQScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {\n    width: 0; border: none; background: transparent;\n}\n"
